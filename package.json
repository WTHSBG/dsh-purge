{
  "name": "dsh-purge",
  "version": "1.1.78",
  "description": "DeepSeek Harness 破甲：让所有模型都能破甲，不同模型可换不同提示词；默认提示词面向国模「小码酱」。Jailbreak for every model — swap prompts per model. 求 Star 收藏 ⭐ 如要二开，请查看署名要求部分",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-purge": "bin/dsh-purge.js"
  },
  "files": [
    "lib",
    "!lib/default-prompt-inject.md",
    "bin",
    "docs",
    "scripts",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "embed-prompt": "node scripts/embed-default-prompt.mjs",
    "audit:patches": "node scripts/audit-patches.mjs",
    "postinstall": "node scripts/ensure-profile-bundle.mjs"
  },
  "license": "Apache-2.0",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "网络安全",
    "llm-security",
    "harness-security",
    "deepseek-harness",
    "instructions",
    "rules",
    "prompt-eval",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YuJunZhiXue/dsh-purge.git"
  },
  "homepage": "https://github.com/YuJunZhiXue/dsh-purge#readme",
  "bugs": {
    "url": "https://github.com/YuJunZhiXue/dsh-purge/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "install": {
      "preferred": "tarball",
      "tarball": "https://codeload.github.com/WTHSBG/dsh-purge/tar.gz/refs/heads/dev",
      "zip": "https://codeload.github.com/WTHSBG/dsh-purge/zip/refs/heads/dev",
      "git": "https://github.com/WTHSBG/dsh-purge.git"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": {
    "node": ">=18"
  },
  "dshTarget": "0.2.1-rc.2"
}
